APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+psycopg://<managed-user>:<managed-password>@<managed-host>:5432/changu
SECRET_KEY=<inject-a-random-secret-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["https://app.example.com"]
AI_PROVIDER=rules
GEMINI_API_KEY=
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
AI_DAILY_REQUEST_LIMIT=30
DELIVERY_FEE=30
TAX_RATE=0
DELIVERY_EARNING=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
